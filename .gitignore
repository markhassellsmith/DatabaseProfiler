# ===========================================
# DatabaseProfiler Application-Specific Ignores
# ===========================================

# Generated table report job files (runtime metadata)
DatabaseProfiler.App/App_Data/TableReports/jobs/*.json

# Generated table report artifacts (Excel files)  
DatabaseProfiler.App/App_Data/TableReports/artifacts/*.xlsx

# Data Protection Keys (contains sensitive encryption keys)
DatabaseProfiler.App/App_Data/DataProtectionKeys/*.xml

# Keep directory structure
!DatabaseProfiler.App/App_Data/TableReports/jobs/.gitkeep
!DatabaseProfiler.App/App_Data/TableReports/artifacts/.gitkeep
!DatabaseProfiler.App/App_Data/DataProtectionKeys/.gitkeep
