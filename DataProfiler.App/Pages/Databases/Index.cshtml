@page
@model DataProfiler.App.Pages.Databases.IndexModel
@{
    ViewData["Title"] = "Databases";
}

<h1>Databases</h1>
<p class="text-muted">Select a database from the connected SQL Server instance.</p>

<div class="row">
    <div class="col-md-8">
        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="SelectedDatabaseName" class="form-label"></label>
                <select asp-for="SelectedDatabaseName" class="form-select" asp-items="Model.DatabaseNames"></select>
            </div>
            <button type="submit" class="btn btn-primary">Select Database</button>
        </form>
    </div>
</div>
