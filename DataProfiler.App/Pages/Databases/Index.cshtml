@page
@model DataProfiler.App.Pages.Databases.IndexModel
@{
    ViewData["Title"] = "Databases";
}

<h1>Databases</h1>

@if (!string.IsNullOrWhiteSpace(Model.ConnectionStatus))
{
    <div class="alert alert-success" role="alert">
        @* @Model.ConnectionStatus *@
        @if (!string.IsNullOrWhiteSpace(Model.ConnectedServerName))
        {
            <span class="ms-2">@Model.StatusMessage</span>
        }
    </div>
}

<div class="row">
    <div class="col-md-8">
        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="SelectedDatabaseName" class="form-label">Select a database from the connected SQL Server:</label>
                <select asp-for="SelectedDatabaseName" class="form-select" asp-items="Model.DatabaseNames"></select>
            </div>
            <button type="submit" class="btn btn-primary">View Objects</button>
        </form>
    </div>
</div>
