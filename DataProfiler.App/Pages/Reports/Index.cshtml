@page
@model DataProfiler.App.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports and Scripts";
}

<h1>Reports and Scripts</h1>
<p class="text-muted">Review the available report formats and SQL scripts for discovered objects.</p>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header">Report Formats</div>
            <ul class="list-group list-group-flush">
                @foreach (var format in Model.ViewModel.ExportFormats)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@format</span>
                        <span class="badge bg-secondary">Available</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header">SQL Scripts</div>
            <ul class="list-group list-group-flush">
                @foreach (var scriptType in Model.ViewModel.ScriptObjectTypes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@scriptType</span>
                        <span class="badge bg-secondary">Downloadable</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="mt-4 alert alert-info">
    Report and script output can be viewed here and later downloaded from the export workflow.
</div>
