@page
@model DataProfiler.App.Pages.ColumnBrowser.IndexModel
@{
    ViewData["Title"] = "Column Browser";
}

<h1>Column Browser</h1>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <div class="text-muted small d-flex flex-wrap gap-3">
        <span><strong>Server:</strong> @Model.ViewModel.ServerName</span>
        <span><strong>Database:</strong> @Model.ViewModel.DatabaseName</span>
        <span><strong>Table:</strong> @Model.ViewModel.SelectedTableDisplayName</span>
    </div>
    <a asp-page="/ObjectBrowser/Index"
       asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
       class="btn btn-outline-secondary btn-sm">
        Back to Object Browser
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post" class="row g-3 align-items-end mb-3">
    <div class="col-md-6">
        <label asp-for="SelectedTableSelectionValue" class="form-label">Table</label>
        <select asp-for="SelectedTableSelectionValue" class="form-select" asp-items="Model.TableNames"></select>
    </div>
    <div class="col-md-3">
        <input type="hidden" asp-for="SelectedDatabaseName" />
        <input type="hidden" asp-for="SelectedTableSchemaName" />
        <input type="hidden" asp-for="SelectedTableName" />
        <input type="hidden" asp-for="SortColumn" />
        <input type="hidden" asp-for="SortDescending" />
        <button type="submit" class="btn btn-primary">Refresh Schema</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Columns for @Model.ViewModel.SelectedTableDisplayName</span>
        <span class="text-muted small">Defaults, keys, and indexes are loaded from the selected database</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 30px;"></th>
                    <th>
                        <a asp-page="/ColumnBrowser/Index"
                           asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
                           asp-route-SelectedTableSchemaName="@Model.SelectedTableSchemaName"
                           asp-route-SelectedTableName="@Model.SelectedTableName"
                           asp-route-SortColumn="Ordinal"
                           asp-route-SortDescending="@Model.GetNextSortDescending("Ordinal")"
                           class="schema-browser-sort-link">
                            Ordinal @Model.GetSortIndicator("Ordinal")
                        </a>
                    </th>
                    <th>
                        <a asp-page="/ColumnBrowser/Index"
                           asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
                           asp-route-SelectedTableSchemaName="@Model.SelectedTableSchemaName"
                           asp-route-SelectedTableName="@Model.SelectedTableName"
                           asp-route-SortColumn="Name"
                           asp-route-SortDescending="@Model.GetNextSortDescending("Name")"
                           class="schema-browser-sort-link">
                            Name @Model.GetSortIndicator("Name")
                        </a>
                    </th>
                    <th>
                       <a asp-page="/ColumnBrowser/Index"
                           asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
                           asp-route-SelectedTableSchemaName="@Model.SelectedTableSchemaName"
                           asp-route-SelectedTableName="@Model.SelectedTableName"
                           asp-route-SortColumn="DataType"
                           asp-route-SortDescending="@Model.GetNextSortDescending("DataType")"
                           class="schema-browser-sort-link">
                            Data Type @Model.GetSortIndicator("DataType")
                        </a>
                    </th>
                    <th>
                        <a asp-page="/ColumnBrowser/Index"
                           asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
                           asp-route-SelectedTableSchemaName="@Model.SelectedTableSchemaName"
                           asp-route-SelectedTableName="@Model.SelectedTableName"
                           asp-route-SortColumn="Length"
                           asp-route-SortDescending="@Model.GetNextSortDescending("Length")"
                           class="schema-browser-sort-link">
                            Length @Model.GetSortIndicator("Length")
                        </a>
                    </th>
                    <th>Nullable</th>
                    <th>PK</th>
                    <th>Indexed</th>
                    <th>FK</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var column in Model.ViewModel.Columns)
                {
                    var rowId = $"col-{column.Ordinal}";
                    var detailId = $"detail-{column.Ordinal}";
                    var hasExtendedInfo = column.IsIdentity || column.IsComputed || 
                                          !string.IsNullOrWhiteSpace(column.DefaultValue) ||
                                          !string.IsNullOrWhiteSpace(column.ColumnCollation) ||
                                          (column.PrecisionValue.HasValue && column.PrecisionValue.Value > 0);

                    <tr id="@rowId" class="@(column.IsPrimaryKey ? "fw-bold" : string.Empty)">
                        <td>
                            @if (hasExtendedInfo)
                            {
                                <button type="button" 
                                        class="btn btn-sm btn-link p-0 text-decoration-none" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#@detailId" 
                                        aria-expanded="false" 
                                        aria-controls="@detailId"
                                        title="Show/Hide Details">
                                    <svg width="16" height="16" fill="currentColor">
                                        <path d="M5 7l3 3 3-3H5z"/>
                                    </svg>
                                </button>
                            }
                        </td>
                        <td>@column.Ordinal</td>
                        <td>
                            @column.Name
                            @if (column.IsIdentity)
                            {
                                <span class="badge bg-info text-dark ms-1">Identity</span>
                            }
                            @if (column.IsComputed)
                            {
                                <span class="badge bg-warning text-dark ms-1">Computed</span>
                            }
                        </td>
                        <td>@column.DataType</td>
                        <td>@column.LengthDisplay</td>
                        <td>@(column.IsNullable ? "Yes" : "No")</td>
                        <td>@(column.IsPrimaryKey ? "Yes" : "No")</td>
                        <td>@(column.IsIndexed ? "Yes" : "No")</td>
                        <td>@(column.IsForeignKey ? "Yes" : "No")</td>
                    </tr>
                    @if (hasExtendedInfo)
                    {
                        <tr>
                            <td colspan="9" class="p-0 border-0">
                                <div id="@detailId" class="collapse">
                                    <div class="card card-body extended-column-info-panel m-2">
                                        <h6 class="mb-2">Extended Column Information</h6>
                                        <div class="row g-2 small">
                                            @if (column.PrecisionValue.HasValue && column.PrecisionValue.Value > 0)
                                            {
                                                <div class="col-md-6">
                                                    <strong>Precision:</strong> @column.PrecisionValue
                                                    @if (column.ScaleValue.HasValue)
                                                    {
                                                        <text>, <strong>Scale:</strong> @column.ScaleValue</text>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(column.ColumnCollation))
                                            {
                                                <div class="col-md-6">
                                                    <strong>Collation:</strong> @column.ColumnCollation
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(column.DefaultValue))
                                            {
                                                <div class="col-12">
                                                    <strong>Default Value:</strong> <code>@column.DefaultValue</code>
                                                </div>
                                            }
                                            @if (column.IsIdentity)
                                            {
                                                <div class="col-md-6">
                                                    <strong>Identity Seed:</strong> @(column.IdentitySeed?.ToString() ?? "N/A")
                                                </div>
                                                <div class="col-md-6">
                                                    <strong>Identity Increment:</strong> @(column.IdentityIncrement?.ToString() ?? "N/A")
                                                </div>
                                            }
                                            @if (column.IsComputed && !string.IsNullOrWhiteSpace(column.ComputedDefinition))
                                            {
                                                <div class="col-12">
                                                    <strong>Computed Definition:</strong> <code>@column.ComputedDefinition</code>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>