@page
@model DatabaseProfiler.App.Pages.ScriptBrowser.IndexModel
@{
    ViewData["Title"] = "Script Browser";
}

<h1>Script Browser</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="alert">
        @Model.StatusMessage
    </div>
}

<div class="mb-3">
    <a asp-page="/ObjectBrowser/Index"
       asp-route-SelectedDatabaseName="@Model.SelectedDatabaseName"
       class="btn btn-outline-secondary btn-sm">
        Back to Object Browser
    </a>
</div>

@if (Model.ViewModel.ScriptLines.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        The CREATE script could not be displayed for this object.
    </div>
}
else
{
    <div class="card shadow-sm script-browser-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>CREATE script</span>
            <span class="text-muted small">Line-numbered view</span>
        </div>
        <div class="table-responsive script-browser-scroll">
            <table class="table table-sm mb-0 script-browser-table">
                <tbody>
                    @foreach (var line in Model.ViewModel.ScriptLines)
                    {
                        <tr>
                            <td class="script-browser-line-number">@line.LineNumber</td>
                            <td class="script-browser-line-text"><pre class="mb-0">@line.Text</pre></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
