@page
@model DatabaseProfiler.App.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<h1>Reports</h1>

<p class="text-muted">
    Choose the kind of report you want to create. The table-focused Excel report is the first available flow.
</p>

<div class="list-group shadow-sm">
    @foreach (var choice in Model.ReportChoices)
    {
        <div class="list-group-item list-group-item-action p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h2 class="h5 mb-0">@choice.Title</h2>
                        <span class="badge bg-secondary">@choice.Format</span>
                    </div>
                    <p class="mb-0 mt-2">@choice.Description</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(choice.PagePath))
                {
                    <a href="@choice.PagePath" class="btn btn-primary btn-sm">@choice.ActionText</a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled>@choice.ActionText</button>
                }
            </div>
        </div>
    }
</div>

