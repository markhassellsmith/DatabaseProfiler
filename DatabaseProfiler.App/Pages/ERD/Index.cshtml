@page
@model DatabaseProfiler.App.Pages.ERD.IndexModel
@{
    ViewData["Title"] = "Entity-Relationship Diagram Export";
}

<h1>Entity-Relationship Diagram Export</h1>

<div class="mb-3">
    <a asp-page="/Reports/Index" class="btn btn-outline-secondary btn-sm">← Back to Reports</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("✅") ? "alert-success" : "alert-info";
    <div class="alert @alertClass" role="alert">
        @Model.StatusMessage
    </div>

    @* Show download buttons if "Both" format was selected and files are ready *@
    @if (Model.StatusMessage.StartsWith("✅") && Model.ExportFormat == "Both")
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header">Download Files</div>
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-page-handler="DownloadSql" class="btn btn-primary">
                        📥 Download SQL DDL (.sql)
                    </a>
                    <a asp-page-handler="DownloadMermaid" class="btn btn-primary">
                        📥 Download Mermaid (.md)
                    </a>
                </div>
                <div class="mt-2 text-muted small">
                    <strong>SQL DDL:</strong> Import into Microsoft Visio (Database → Reverse Engineer)<br>
                    <strong>Mermaid:</strong> View in VS Code, GitHub, or at <a href="https://mermaid.live" target="_blank">mermaid.live</a>
                </div>
            </div>
        </div>
    }
}

<div class="alert alert-info" role="alert">
    <strong>📊 Generate Entity-Relationship Diagrams</strong><br>
    Select tables to include in the diagram. You can generate:
    <ul class="mb-0 mt-2">
        <li><strong>SQL DDL:</strong> Import into Microsoft Visio Professional (Database → Reverse Engineer)</li>
        <li><strong>Mermaid:</strong> View in VS Code, GitHub, or any markdown viewer with Mermaid support</li>
        <li><strong>Both:</strong> Download both formats for maximum compatibility</li>
    </ul>
</div>

<form method="post" asp-page-handler="Export">
    <input type="hidden" asp-for="SelectedDatabaseName" />

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Select Tables</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Table selection controls">
                <button type="button" class="btn btn-outline-secondary" id="check-all-tables">Check all</button>
                <button type="button" class="btn btn-outline-secondary" id="uncheck-all-tables">Uncheck all</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 2.5rem;">
                            <input type="checkbox" id="select-all-tables" aria-label="Select all tables" />
                        </th>
                        <th>Table</th>
                        <th class="text-end">Rows</th>
                        <th class="text-end">Columns</th>
                        <th>PK</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in Model.AvailableTables)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input table-checkbox"
                                       type="checkbox"
                                       name="SelectedTableIds"
                                       value="@table.SelectionValue"
                                       checked="@(Model.SelectedTableIds.Contains(table.SelectionValue, StringComparer.OrdinalIgnoreCase))" />
                            </td>
                            <td>
                                <span class="fw-semibold">@table.Name</span>
                                <div class="text-muted small">@table.SchemaName</div>
                            </td>
                            <td class="text-end">@table.RowCount.ToString("N0")</td>
                            <td class="text-end">@table.ColumnCount</td>
                            <td>@(table.HasPrimaryKey ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header">Relationship Options</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="IncludeExplicitFKs" id="includeExplicitFKs" />
                <label class="form-check-label" for="includeExplicitFKs">
                    <strong>Include explicit foreign keys</strong>
                    <div class="text-muted small">Show actual FK constraints defined in the database</div>
                </label>
            </div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" asp-for="IncludeSuggestedRelationships" id="includeSuggestedRelationships" />
                <label class="form-check-label" for="includeSuggestedRelationships">
                    <strong>Include suggested relationships</strong>
                    <div class="text-muted small">Show inferred relationships based on naming patterns (e.g., CustomerID → Customer)</div>
                </label>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header">Export Format</div>
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="ExportFormat" value="Both" id="formatBoth" checked />
                <label class="form-check-label" for="formatBoth">
                    <strong>Both (SQL DDL + Mermaid)</strong>
                    <div class="text-muted small">Downloads both files for maximum compatibility</div>
                </label>
            </div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" asp-for="ExportFormat" value="SqlDdl" id="formatSql" />
                <label class="form-check-label" for="formatSql">
                    <strong>SQL DDL only</strong>
                    <div class="text-muted small">CREATE TABLE statements with foreign key constraints (for Microsoft Visio import)</div>
                </label>
            </div>
            <div class="form-check mt-2">
                <input class="form-check-input" type="radio" asp-for="ExportFormat" value="Mermaid" id="formatMermaid" />
                <label class="form-check-label" for="formatMermaid">
                    <strong>Mermaid only</strong>
                    <div class="text-muted small">Markdown file with embedded ERD diagram (for GitHub/VS Code/documentation)</div>
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="text-muted small">
            📁 Files will be named: <code>DatabaseName_ERD_yyyyMMdd_HHmmss.{sql|md}</code>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">
            📥 Generate ERD
        </button>
    </div>
</form>

<script>
    (() => {
        const selectAll = document.getElementById('select-all-tables');
        const checkAll = document.getElementById('check-all-tables');
        const uncheckAll = document.getElementById('uncheck-all-tables');
        const checkboxes = () => Array.from(document.querySelectorAll('.table-checkbox'));

        const syncSelectAllState = () => {
            const items = checkboxes();
            if (items.length === 0) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
                return;
            }

            const checkedCount = items.filter(x => x.checked).length;
            selectAll.checked = checkedCount === items.length;
            selectAll.indeterminate = checkedCount > 0 && checkedCount < items.length;
        };

        const setAll = (checked) => {
            checkboxes().forEach(cb => cb.checked = checked);
            syncSelectAllState();
        };

        selectAll?.addEventListener('change', () => setAll(selectAll.checked));
        checkAll?.addEventListener('click', () => setAll(true));
        uncheckAll?.addEventListener('click', () => setAll(false));
        checkboxes().forEach(cb => cb.addEventListener('change', syncSelectAllState));
        syncSelectAllState();
    })();
</script>
